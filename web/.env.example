# Hibiscus Admissions — web environment
#
# Copy to `.env.local` for local development, and set the same names in the
# Vercel project's Environment Variables for production. Real values are never
# committed: `.env*` is gitignored, and this file is the only exception.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the JavaScript the browser
# downloads and is readable by anyone using the site. That is fine for the two
# below, and is why NO OTHER KEY MAY EVER BE GIVEN THAT PREFIX.

# ── Public: safe in the browser ──────────────────────────────────────────────

# Supabase project REST endpoint.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase publishable (anon) key. Grants nothing on its own: every table's
# access is decided by Postgres row-level security, and parents are never
# database principals at all — see lib/supabase/admin.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where the site is served from. Used to build absolute links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry error monitoring. Public by design — a DSN can only SEND events to
# your project, never read them. Leave unset to switch monitoring off.
NEXT_PUBLIC_SENTRY_DSN=

# ── Secret: server-side only, never prefixed NEXT_PUBLIC_ ────────────────────

# Supabase service-role key. Bypasses row-level security completely. Used by
# the workflow engine, the job drain, and every parent-facing route after a
# magic-link token has been verified. If this ever reaches the browser or a git
# commit, rotate it immediately in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the short-lived parent session cookie that a magic link is exchanged
# for. 32+ random bytes, base64 or hex. Rotating it logs every parent out of
# their current step, which is harmless — their emailed link still works.
#   openssl rand -base64 32
PARENT_SESSION_SECRET=

# Authenticates the Vercel cron that drains the job queue (/api/jobs/drain).
# Vercel sends it as `Authorization: Bearer <value>` automatically when the
# variable is named CRON_SECRET. Any other caller without it gets a 401.
CRON_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────

# Which adapter to use. `dev` writes every email to the database only, where it
# can be read at /staff/admin/dev-outbox — nothing is sent. `resend` sends for
# real. Unset behaves as `dev`, so a misconfigured deploy cannot spam parents.
EMAIL_PROVIDER=dev

# Resend API key and the verified sending identity. The domain must carry
# SPF, DKIM and DMARC records before a single parent email is sent, or the
# emails that drive this whole journey land in spam.
RESEND_API_KEY=
EMAIL_FROM="Hibiscus Schools Admissions <admissions@example.com>"

# Resend signs webhooks (delivery, open, click events) with this secret.
RESEND_WEBHOOK_SECRET=

# ── AI (Phase 2: learning-profile narrative and writing-band suggestion) ────

# Which adapter to use. `dev` returns deterministic text and needs no key, so
# every profile is generated by the fallback wording. `anthropic` calls the
# Claude API. Unset behaves as `dev`. Whatever the adapter, the validator in
# lib/profile/narrative.ts stands between the model and the parent: any
# number it did not receive, or any diagnostic word, and the fallback is used.
AI_PROVIDER=dev

# Anthropic API key. Only read when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Optional model override; defaults to claude-opus-5 in lib/ai/anthropic.ts.
AI_MODEL=

# ── Payments (Phase 3) ──────────────────────────────────────────────────────

# Which gateway adapter to use. `dev` charges nothing and can only report a
# payment as made when the development screen at /pay/dev simulates it; it
# refuses to load in production. `dpo` is DPO Pay's hosted payment page.
# Unset behaves as `dev`, so a misconfigured deploy cannot take money.
PAYMENT_PROVIDER=dev

# DPO Pay merchant credentials, from the DPO merchant portal. Only read when
# PAYMENT_PROVIDER=dpo. The API URL defaults to live; point it at the sandbox
# (https://secure1.sandbox.directpay.online/API/v6/) while testing.
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_API_URL=

# ── Documents and enrolment (Phase 3) ────────────────────────────────────────

# Malware scanning for uploaded documents. `none` (the default and the only
# implementation so far) stores every file as "not scanned" and says so to
# staff. A scanner is a second implementation in lib/documents/scanner.ts.
DOCUMENT_SCANNER=none

# AI document extraction (Phase 4). `none` (the default) never reads a file.
# `anthropic` sends birth certificates and reports to Claude through the AI
# provider and proposes values; a proposal never overwrites the registration,
# it flags a difference for the parent to confirm. Also gated by the
# ai_extraction_enabled workflow setting. Medical documents are never sent.
DOCUMENT_EXTRACTOR=none

# The school's student management system. `none` (the default) keeps the
# enrolment record downloadable as JSON with export_status pending. Ed-admin
# is a second implementation in lib/enrolment/integration.ts when its API is
# known.
STUDENT_SYSTEM=none

# ── WhatsApp (Phase 4) ───────────────────────────────────────────────────────

# Which messaging adapter to use. `dev` records every message in the database
# only, where it can be read at /staff/admin/dev-outbox — nothing is sent.
# `meta` sends through Meta's WhatsApp Cloud API. Unset behaves as `dev`. The
# channel is also gated by the whatsapp_enabled workflow setting (default off)
# and by each parent's opt-in.
MESSAGING_PROVIDER=dev

# Meta WhatsApp Cloud API credentials, from Meta Business Manager. Only read
# when MESSAGING_PROVIDER=meta. The API URL defaults to the current Graph API
# version in lib/messaging/meta.ts.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_URL=

# Meta signs webhooks (delivery statuses, parents' replies) with the app
# secret; the verify token is a value you choose and enter in Meta when
# registering <site>/api/webhooks/whatsapp.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
