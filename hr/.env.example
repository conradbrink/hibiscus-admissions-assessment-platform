# The HR app. Same Supabase project as admissions (one set of staff
# accounts and campuses); its own secrets everywhere else.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Give the HR app its own secret key in the Supabase dashboard, so it can be
# rotated without touching admissions. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Where this app is served, used in every emailed link.
NEXT_PUBLIC_SITE_URL=https://hr.example.org
# The admissions console, for the "Forgotten your password?" link and the
# switch in the sidebar. Staff reset passwords there; it is the same account.
NEXT_PUBLIC_ADMISSIONS_URL=https://admissions.example.org

# Signs the applicant and referee cookies and salts hashed IP addresses.
# At least 32 random characters, and different from admissions' secret.
HR_SESSION_SECRET=
# Bearer token for /api/jobs/drain (pg_cron, GitHub Actions and Vercel cron).
CRON_SECRET=

# Email. "dev" records every message in hr_email_messages and sends nothing.
EMAIL_PROVIDER=dev
RESEND_API_KEY=
EMAIL_FROM="Hibiscus International Schools HR <careers@example.org>"
EMAIL_REPLY_TO=
# The signing secret of the HR app's own Resend webhook (/api/webhooks/email).
RESEND_WEBHOOK_SECRET=

# AI. "dev" returns placeholder output and marks nothing: answers are then
# marked by a person and the AI-writing check shows "Not checked".
AI_PROVIDER=dev
ANTHROPIC_API_KEY=
AI_MODEL=

# "none" stores files as not_scanned until a scanner is configured.
DOCUMENT_SCANNER=none
